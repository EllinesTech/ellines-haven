# ── Security + Cache headers for Cloudflare Pages ───────────────────────────
# IMPORTANT: Cloudflare Pages COMBINES matching header blocks (they do not
# fully override). Avoid putting CDN-Cache-Control on /* — it stacks onto
# /assets/* and can force asset MISS/0 TTL or poison 404 responses.
#
# HTML must be cacheable for Google indexing (public) but always revalidate so
# browsers never keep a stale index.html that points at old hashed JS chunks.
# NEVER use no-store on HTML — it blocks Google from indexing the site.
#
# Do NOT set CDN-Cache-Control: immutable on /assets/*. Pages already edge-
# caches successful assets and purges on deploy. Custom long CDN TTLs also
# attach to missing-asset 404s (via /assets/* → 404.html) and can sticky-
# cache "not found" at the edge after a deploy race.

# Default — HTML + unhashed files: revalidate every time (browser).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: public, max-age=0, must-revalidate

# Document shell — never long-cached at the edge.
# `/` and `/index.html` both matter: custom-domain requests often hit `/`
# without matching `/index.html`, and a cached HTML shell points at deleted
# Vite hashes (vendor-firebase-core-*.js / index-*.js) → console 404s.
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-cache

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-cache

# Custom 404 body — never cache (also used for missing /assets/* hashes)
/404.html
  Cache-Control: no-store
  CDN-Cache-Control: no-store

# Hashed JS/CSS — long browser cache only. Let Pages manage edge TTL/purge.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker — never cache (kill-switch must reach clients immediately)
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Pragma: no-cache

# Deploy version stamp — never cache (app polls this to detect new deploys)
/version.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Content-Type: application/json

# PWA manifest — short cache
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  CDN-Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/json

# Sitemap — 1 day cache (SEO: Google caches this anyway)
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  CDN-Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml

# Robots
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  CDN-Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain

# IndexNow key (Bing / Yandex / others)
/1b9faca8a192e88f7c3d4e5b6a708192.txt
  Cache-Control: public, max-age=86400, must-revalidate
  CDN-Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8

# Google Search Console verification file
/google17caeb8194dadb8a.html
  Cache-Control: public, max-age=3600, must-revalidate
  CDN-Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/html; charset=utf-8

# Images
/*.png
  Cache-Control: public, max-age=86400, must-revalidate

/*.jpg
  Cache-Control: public, max-age=86400, must-revalidate

/*.jpeg
  Cache-Control: public, max-age=86400, must-revalidate

/*.webp
  Cache-Control: public, max-age=86400, must-revalidate

/*.svg
  Cache-Control: public, max-age=86400, must-revalidate

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable
