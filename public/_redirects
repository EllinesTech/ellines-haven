# SPA fallback — ALL routes serve index.html EXCEPT /assets/
# If an /assets/ file is missing (stale browser/CDN HTML pointing to an old hash),
# return a proper 404 instead of serving index.html with text/html MIME type.
# Serving index.html for a .js/.css request causes MIME errors and a crash loop.
/assets/* /assets/:splat 404
/* /index.html 200
