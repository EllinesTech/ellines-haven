# Missing hashed assets must NOT fall through to the SPA shell.
# Serving index.html for .js/.css causes "Unable to preload CSS" / MIME crashes.
/assets/*  /404.html  404

# SPA fallback for client routes. Cloudflare Pages still serves real files first
# (e.g. /library/index.html from prerender) before this rewrite applies.
/*    /index.html   200
