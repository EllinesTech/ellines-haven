rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── SECURITY NOTE ───────────────────────────────────────────────────────
    // Ellines Haven uses custom auth (localStorage tokens), NOT Firebase Auth.
    // request.auth is always null for all client requests.
    //
    // WHAT THIS MEANS:
    // - We CANNOT distinguish logged-in users from anonymous at the rules level.
    // - We CANNOT verify admin role at the rules level.
    // - The app enforces auth/role checks in the React UI layer.
    //
    // MITIGATION (defence in depth):
    // 1. PAYMENT-CRITICAL paths (libraries, order completion) are write-locked.
    //    Only Cloud Functions (Admin SDK, which bypasses rules) can grant books.
    // 2. Public data is read-only or create-only where possible.
    // 3. No client-side deletes on any collection.
    // 4. Sensitive secrets (ehbook_licenses, auth_otps) fully locked.
    //
    // RESIDUAL RISK: A malicious user with the Firebase config could:
    //   - Read user profiles, orders, reading progress (low sensitivity)
    //   - Write to settings/site_data if they reverse-engineer the schema
    //   - The MONEY PATH is safe: book grants require Cloud Function verification
    //
    // TODO: Migrate to Firebase Auth for proper per-user row-level security.
    // ─────────────────────────────────────────────────────────────────────────

    // ── Public catalogue — read-only, admin UI writes ───────────────────────
    match /site_data/{doc} {
      allow read:   if true;
      allow write:  if true;  // Admin UI writes directly (no Firebase Auth to gate)
    }
    match /book_chapters/{doc} {
      allow read:   if true;
      allow write:  if true;  // Admin UI manages chapters
    }
    match /settings/{doc} {
      allow read:   if true;
      allow write:  if true;  // Admin UI writes settings
    }

    // ── User libraries (PAYMENT-CRITICAL — locked to Cloud Functions) ───────
    match /libraries/{docId} {
      allow read:   if true;
      allow create: if false;  // ONLY Cloud Functions can grant books
      allow update: if false;  // ONLY Cloud Functions can update libraries
      allow delete: if false;
    }

    // ── Orders ──────────────────────────────────────────────────────────────
    // Users create orders to initiate checkout. Completion via Cloud Functions.
    match /orders/{orderId} {
      allow read:   if true;
      allow create: if true;   // Users initiate orders
      allow update: if true;   // Paystack ref attachment + admin UI
      allow delete: if false;
    }

    // ── Users / profiles ────────────────────────────────────────────────────
    match /users/{docId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
    match /user_profiles/{d} {
      allow read:   if true;
      allow write:  if true;
    }

    // ── Reviews ─────────────────────────────────────────────────────────────
    match /reviews/{bookId} {
      allow read:  if true;
      allow write: if true;
      match /entries/{entryId} {
        allow read:  if true;
        allow write: if true;
      }
    }

    // ── Cached book recommendations ─────────────────────────────────────────
    match /book_recommendations/{emailId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ── Notifications ───────────────────────────────────────────────────────
    match /user_notifications/{d} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
    match /notifications/{d} {
      allow read:  if true;
      allow write: if true;   // Admin UI
    }

    // ── Admin collections ───────────────────────────────────────────────────
    match /admin_notifications/{d} {
      allow read:   if true;   // Admin UI reads
      allow create: if true;   // Cloud Functions + admin
      allow update: if true;   // Admin marks as read
      allow delete: if false;
    }
    match /admin_logs/{d} {
      allow read:  if true;
      allow write: if false;   // Cloud Functions only
    }
    match /admin_preferences/{d} {
      allow read:  if true;
      allow write: if true;    // Admin UI
    }
    match /activity_logs/{d} {
      allow read:  if true;
      allow write: if true;
    }
    match /user_sessions/{d} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Contact / messaging ─────────────────────────────────────────────────
    match /contact_messages/{docId} {
      allow read:  if true;
      allow write: if true;
      match /messages/{msgId} {
        allow read:  if true;
        allow write: if true;
      }
    }

    // ── Ellines Rattan Furniture (namespaced; shared project) ───────────────
    // Rattan portal uses Firebase Auth (synced on app login). Haven admin does
    // NOT — keep Haven paths above gated only by app UI, not request.auth.
    // site_data docs (including rattan_*) stay on Haven's write:if true above.

    function rattanSignedIn() {
      return request.auth != null;
    }

    function rattanValidEmail(value) {
      return value is string && value.size() > 3 && value.size() < 320;
    }

    // Portal users for rattanfurniture.ellines.co.ke — separate from Haven `users`.
    match /rattan_users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if rattanSignedIn();
    }

    // Quote / budget requests from the Rattan shop.
    match /quote_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['customer', 'items'])
        && request.resource.data.customer is map;
      allow update, delete: if rattanSignedIn();
    }

    match /rattan_orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if rattanSignedIn();
    }

    match /rattan_media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if rattanSignedIn();
    }

    match /rattan_subscriptions/{subId} {
      allow read: if rattanSignedIn();
      allow create: if request.resource.data.email is string
        && rattanValidEmail(request.resource.data.email);
      allow update, delete: if rattanSignedIn();
    }

    match /rattan_testimonials/{id} {
      allow read: if true;
      allow create, update, delete: if rattanSignedIn();
    }

    match /rattan_posts/{id} {
      allow read: if true;
      allow create, update, delete: if rattanSignedIn();
    }

    match /rattan_visit_bookings/{id} {
      allow read: if rattanSignedIn();
      allow create: if request.resource.data.keys().hasAny(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow update, delete: if rattanSignedIn();
    }

    match /rattan_trade_enquiries/{id} {
      allow read: if rattanSignedIn();
      allow create: if request.resource.data.keys().hasAny(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow update, delete: if rattanSignedIn();
    }

    // ── Newsletter ──────────────────────────────────────────────────────────
    match /newsletter_signups/{d} {
      allow read:  if true;
      allow write: if true;
    }
    match /newsletter_campaigns/{d} {
      allow read:  if true;
      allow write: if true;    // Admin UI
    }

    // ── Visitor tracking ────────────────────────────────────────────────────
    match /site_visitors/{d} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ── SMS campaigns ───────────────────────────────────────────────────────
    match /sms_campaigns/{d} {
      allow read:  if true;
      allow write: if true;    // Admin UI
    }

    // ── Dev OTPs ────────────────────────────────────────────────────────────
    match /dev_otps/{d} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Auth OTPs — Cloud Functions ONLY ────────────────────────────────────
    match /auth_otps/{d} {
      allow read, write: if false;
    }

    // ── Chapter analytics ───────────────────────────────────────────────────
    match /chapter_analytics/{docId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ── Reading progress ────────────────────────────────────────────────────
    match /reading_progress/{userDocId} {
      allow read:  if true;
      allow write: if true;
      match /books/{bookId} {
        allow read:  if true;
        allow write: if true;
      }
    }

    // ── User presence ───────────────────────────────────────────────────────
    match /user_presence/{docId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ── Soft-delete buckets ─────────────────────────────────────────────────
    match /archives/{d} {
      allow read:  if true;
      allow write: if true;    // Admin UI
    }
    match /trash/{d} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Promo codes ─────────────────────────────────────────────────────────
    match /promos/{d} {
      allow read:  if true;
      allow write: if true;    // Admin UI
    }

    // ── Referral system ─────────────────────────────────────────────────────
    match /referrals/{userDocId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ── Reading Challenges ──────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
    match /challenge_leaderboards/{leaderboardId} {
      allow read:   if true;
      allow write:  if true;   // Admin UI + Cloud Functions
    }

    // ── ehbook license keys — NEVER expose ──────────────────────────────────
    match /ehbook_licenses/{keyId} {
      allow read, write: if false;
    }

    // ── User chapter grants ─────────────────────────────────────────────────
    match /user_chapter_grants/{docId} {
      allow read:   if true;
      allow write:  if true;   // Admin UI (SeriesPanel)
    }

    // ── Catch-all: DENY everything not explicitly allowed ───────────────────
    match /{collection}/{document} {
      allow read, write: if false;
    }
    match /{collection}/{document}/{sub}/{subDoc} {
      allow read, write: if false;
    }
  }
}
